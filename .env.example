NODE_ENV=development
MAT_ENVIRONMENT=LOCAL-DEVELOPMENT
MAT_DEMO_MODE=0
MAT_EPHEMERAL=0
MAT_DB_MODE=postgres
MAT_BIND_HOST=127.0.0.1
MAT_COOKIE_SECURE=0
MAT_REQUIRE_HTTPS=0
MAT_TRUSTED_PROXIES=127.0.0.1,::1
MAT_SESSION_TOUCH_MS=300000
MAT_BOOTSTRAP_OWNER_USERNAME=owner
MAT_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MAT_BOOTSTRAP_OWNER_PIN=CHANGE_ME_8_DIGIT_PIN
MAT_MFA_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
# AES-256-GCM application-layer encryption untuk rekening/restricted records.
# Rotasi: pindahkan key lama ke JSON previous, isi current key+ID baru, lalu
# jalankan `npm run security:rotate-fields`.
MAT_FIELD_ENCRYPTION_KEY_ID=v1
MAT_FIELD_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
MAT_FIELD_BLIND_INDEX_KEY=CHANGE_ME_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET
MAT_FIELD_ENCRYPTION_PREVIOUS_KEYS={}

# Wave D.1 — penegakan coding block dimensi pada baris jurnal.
# OFF  = abaikan dimensi; SOFT = validasi FK yang dikirim (default, rollout aman);
# HARD = paksa cost/profit center wajib pada akun P&L. Baseline v0.39 adalah
# HARD; gunakan SOFT hanya sementara dalam cut-over yang terdokumentasi.
MAT_JOURNAL_DIMENSION_ENFORCEMENT=HARD
MAT_UAT_DEFAULT_PASSWORD=GENERATED_BY_DB_SEED_UAT
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mat_erp_v2_dev
PGUSER=mat_erp_app
PGPASSWORD=CHANGE_ME
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mat_erp_app:CHANGE_ME@127.0.0.1:5432/mat_erp_v2_dev
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/mat_erp_v2_dev
DB_POOL_MIN=2
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=20000
DB_SSL=0
MAT_UPLOAD_MAX_BYTES=20971520
MAT_FILE_SCAN_MODE=builtin
# Production Windows: defender. Linux: clamav + MAT_CLAMSCAN_PATH.
MAT_DEFENDER_CLI=C:\Program Files\Windows Defender\MpCmdRun.exe
MAT_CLAMSCAN_PATH=clamscan
MAT_BACKUP_SCHEDULE_ENABLED=1
MAT_BACKUP_INTERVAL_HOURS=24
MAT_BACKUP_RETAIN_COUNT=14
# Materialized Executive Cockpit disegarkan worker setiap 1–60 menit.
MAT_REPORT_REFRESH_MINUTES=5
# Salinan offsite terenkripsi (3-2-1): folder di media kedua / mount NAS /
# folder yang disinkronkan ke object storage. Wajib bersama encryption key.
MAT_BACKUP_OFFSITE_DIR=
MAT_BACKUP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
MAT_BACKUP_PREVIOUS_ENCRYPTION_KEY=
# Alert operasional (backup/restore/partisi gagal) via webhook JSON generik.
MAT_ALERT_WEBHOOK_URL=
# Opsional bila PostgreSQL 16 tidak terpasang di lokasi standar:
# PG_PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

# ── SMTP (Sprint 15 / R022) — kosongkan MAT_SMTP_HOST untuk menonaktifkan ──
MAT_SMTP_HOST=
MAT_SMTP_PORT=587
MAT_SMTP_SECURE=0
MAT_SMTP_USER=
MAT_SMTP_PASS=
MAT_SMTP_FROM=no-reply@mat.co.id
# Public URL dipakai QR dokumen resmi. Production wajib HTTPS.
MAT_PUBLIC_BASE_URL=http://127.0.0.1:4173
# Signing key khusus dokumen resmi. Production tidak memakai fallback.
MAT_DOC_VERIFY_KEY_ID=v1
MAT_DOC_VERIFY_SECRET=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
# ── Tanda tangan digital PDF (PAdES/PKCS#7) — opsional ────────────────────
# Kosongkan untuk menerbitkan dokumen TANPA tanda tangan digital (tetap
# memakai kode verifikasi HMAC + QR). Isi dengan PEM (baris dipisah \n).
# PENTING: agar sah secara hukum di Indonesia, sertifikat WAJIB dari PSrE
# terdaftar Kominfo (mis. Privy, VIDA, Peruri, Digisign). Sertifikat
# self-signed hanya untuk uji coba dan tampil "validity unknown" di Adobe.
MAT_DOC_SIGN_CERT=
MAT_DOC_SIGN_KEY=
MAT_DOC_SIGN_REASON=Dokumen resmi diterbitkan sistem MAT ERP
MAT_DOC_SIGN_LOCATION=Bekasi, Indonesia
# Simpan satu key lama selama seluruh dokumen versi lama masih harus diverifikasi.
MAT_DOC_VERIFY_PREVIOUS_KEY_ID=
MAT_DOC_VERIFY_PREVIOUS_SECRET=

# Opsional untuk load LAN. Jika kosong, harness memakai akun UAT dari env;
# jangan pernah menaruh credential nyata di .env.example atau repository.
MAT_LOAD_USERNAME=
MAT_LOAD_PASSWORD=
