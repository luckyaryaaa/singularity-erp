NODE_ENV=development
MAT_ENVIRONMENT=LOCAL-DEVELOPMENT
MAT_DEMO_MODE=0
MAT_EPHEMERAL=0
MAT_DB_MODE=postgres
MAT_BIND_HOST=127.0.0.1
MAT_COOKIE_SECURE=0
MAT_REQUIRE_HTTPS=0
MAT_TRUSTED_PROXIES=127.0.0.1,::1
MAT_SESSION_TOUCH_MS=300000
MAT_BOOTSTRAP_OWNER_USERNAME=owner
MAT_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MAT_BOOTSTRAP_OWNER_PIN=CHANGE_ME_8_DIGIT_PIN
MAT_MFA_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
MAT_UAT_DEFAULT_PASSWORD=GENERATED_BY_DB_SEED_UAT
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mat_erp_v2_dev
PGUSER=mat_erp_app
PGPASSWORD=CHANGE_ME
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mat_erp_app:CHANGE_ME@127.0.0.1:5432/mat_erp_v2_dev
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/mat_erp_v2_dev
DB_POOL_MIN=2
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=20000
DB_SSL=0
MAT_UPLOAD_MAX_BYTES=20971520
MAT_FILE_SCAN_MODE=builtin
# Production Windows: defender. Linux: clamav + MAT_CLAMSCAN_PATH.
MAT_DEFENDER_CLI=C:\Program Files\Windows Defender\MpCmdRun.exe
MAT_CLAMSCAN_PATH=clamscan
MAT_BACKUP_SCHEDULE_ENABLED=1
MAT_BACKUP_INTERVAL_HOURS=24
MAT_BACKUP_RETAIN_COUNT=14
# Salinan offsite terenkripsi (3-2-1): folder di media kedua / mount NAS /
# folder yang disinkronkan ke object storage. Wajib bersama encryption key.
MAT_BACKUP_OFFSITE_DIR=
MAT_BACKUP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
MAT_BACKUP_PREVIOUS_ENCRYPTION_KEY=
# Alert operasional (backup/restore/partisi gagal) via webhook JSON generik.
MAT_ALERT_WEBHOOK_URL=
# Opsional bila PostgreSQL 16 tidak terpasang di lokasi standar:
# PG_PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

# ── SMTP (Sprint 15 / R022) — kosongkan MAT_SMTP_HOST untuk menonaktifkan ──
MAT_SMTP_HOST=
MAT_SMTP_PORT=587
MAT_SMTP_SECURE=0
MAT_SMTP_USER=
MAT_SMTP_PASS=
MAT_SMTP_FROM=no-reply@mat.co.id
# Secret khusus kode verifikasi dokumen resmi (fallback: MFA/backup key)
MAT_DOC_VERIFY_SECRET=
