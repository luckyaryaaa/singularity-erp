  "pages": [
    { "name": "dashboard", "hash": "#/dashboard", "selector": ".hero-exec" },
    { "name": "quotations", "hash": "#/sales/quotations", "selector": ".table-panel" },
    { "name": "work-orders", "hash": "#/production/work-orders", "selector": ".table-panel" },
    { "name": "approvals", "hash": "#/approvals", "selector": ".table-panel" },
    { "name": "report-factory", "hash": "#/reports", "selector": ".exec-library" }
  ]
}
