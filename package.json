{
  "name": "mat-erp-v2",
  "version": "0.49.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:unit": "node --test test/app.test.js test/database-infrastructure.test.js",
    "test:integration": "node --test --test-concurrency=1 test/postgres-auth.integration.test.js test/postgres-concurrency.integration.test.js test/postgres.integration.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/postgres.http.test.js",
    "test:security": "node --test --test-concurrency=1 --test-name-pattern=\"auth|CSRF|session|permission|lockout|security\" test/api.test.js test/postgres.http.test.js",
    "test:authorization": "node --test --test-concurrency=1 --test-name-pattern=\"authorization|role|ditolak|approval|scope|permission|isolation|IDOR|public allowlist\" test/api.test.js test/postgres.http.test.js test/branch-isolation.test.js test/authorization-matrix.test.js",
    "test:migration": "node --test test/database-infrastructure.test.js",
    "test:performance": "node scripts/load-smoke.js",
    "test:ui": "node --test test/app.test.js",
    "test:a11y": "node scripts/accessibility-audit.js",
    "test:visual": "node scripts/ui-smoke-cdp.js",
    "test:all": "npm test",
    "test:uat:isolated": "node scripts/run-isolated-uat-tests.js",
    "security:scan": "node scripts/secret-scan.js",
    "assets:build": "node scripts/build-assets.js",
    "release:build": "node scripts/build-release.js && node scripts/verify-release-artifact.js",
    "release:verify-assets": "node scripts/verify-release-assets.js",
    "db:health": "node scripts/db.js health",
    "db:provision": "node scripts/provision-db.js",
    "db:status": "node scripts/db.js status",
    "db:migrate": "node scripts/db.js migrate",
    "db:validate": "node scripts/db.js validate",
    "db:rollback-verify": "node scripts/verify-migration-rollback.js",
    "db:grant-runtime": "node scripts/grant-runtime.js",
    "db:seed:dev": "node scripts/seed-postgres-dev.js",
    "security:rotate-owner": "node scripts/rotate-owner-password.js",
    "security:rotate-runtime": "node scripts/rotate-runtime-secrets.js",
    "security:rotate-fields": "node scripts/rotate-field-encryption.js --apply",
    "security:fields-status": "node scripts/rotate-field-encryption.js",
    "security:data-audit": "node scripts/audit-data-protection.js",
    "db:seed:uat": "node scripts/seed-postgres-uat.js",
    "db:seed:uat:sprint4": "node scripts/seed-postgres-uat-sprint4.js",
    "backup:run": "node scripts/backup-postgres.js run",
    "backup:restore-test": "node scripts/backup-postgres.js restore-test",
    "backup:decrypt": "node scripts/backup-postgres.js decrypt",
    "predeploy": "node scripts/predeploy-gate.js",
    "load:smoke": "node scripts/load-smoke.js",
    "load:lan": "node scripts/load-lan.js",
    "cutover:opening-inventory": "node scripts/cutover-opening-inventory.js",
    "uat:lan": "node scripts/start-lan-uat.js",
    "uat:evidence:check": "node scripts/uat-evidence.js readiness",
    "uat:validate": "node scripts/uat-evidence.js validate",
    "uat:technical": "node scripts/run-uat-technical.js",
    "data:purge": "node scripts/purge-business-data.js",
    "data:restore-config": "node scripts/restore-config-seed.js",
    "release:verify": "node scripts/verify-release-artifact.js",
    "release:sbom": "node scripts/generate-sbom.js",
    "backup:encrypt-local": "node scripts/backup-postgres.js encrypt-local"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8"
  }
}
